# Copy to .env and fill in. All values are optional: without an API key the
# app falls back to keyword search, local hash embeddings, and heuristic
# planning instead of LLM-backed features.

# OpenAI (chat + embeddings)
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint also works (leave blank for api.openai.com)
#OPENAI_BASE_URL=
#OPENAI_CHAT_MODEL=gpt-4o-mini
#OPENAI_EMBED_MODEL=text-embedding-3-small

# Backend
# Comma-separated list of allowed browser origins (default: *)
#GOVML_CORS_ORIGINS=http://localhost:5173
